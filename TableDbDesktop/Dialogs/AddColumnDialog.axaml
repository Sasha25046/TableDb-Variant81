<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDbDesktop.Dialogs.AddColumnDialog"
        Title="Нова колонка" Width="380" Height="320"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <StackPanel Margin="15" Spacing="8">
        <TextBlock Text="Назва колонки:" FontWeight="Bold"/>
        <TextBox x:Name="NameTextBox"/>

        <TextBlock Text="Тип:" FontWeight="Bold" Margin="0,10,0,0"/>
        <ComboBox x:Name="TypeComboBox" HorizontalAlignment="Stretch"/>

        <TextBlock Text="Значення за замовчуванням (необов'язково):" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBox x:Name="DefaultValueTextBox" PlaceholderText="Залиште порожнім для стандартного нуля"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,15,0,0">
            <Button Content="Скасувати" Click="Cancel_Click" Width="85" HorizontalContentAlignment="Center"/>
            <Button Content="Додати" Click="Ok_Click" Width="85" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>