<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDbDesktop.Dialogs.RowEditorDialog"
        Title="Редактор рядка" Width="420" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Скасувати" Click="Cancel_Click" Width="90" HorizontalContentAlignment="Center"/>
            <Button Content="Зберегти" Click="Save_Click" Width="90" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel" Spacing="2"/>
        </ScrollViewer>
    </DockPanel>
</Window>